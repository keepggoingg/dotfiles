// Tokyo Night fastfetch: run `fastfetch` for screenshots
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "left": 2, "right": 3 }, "color": { "1": "blue", "2": "magenta" } },
  "display": { "separator": "  ", "color": { "keys": "blue" }, "key": { "width": 6 } },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "magenta", "at": "white", "host": "blue" } },
    { "type": "custom", "format": "\u001b[90m─────────────────────────" },
    { "type": "os",       "key": " ",  "keyColor": "blue" },
    { "type": "host",     "key": " ",  "keyColor": "blue" },
    { "type": "cpu",      "key": " ",  "keyColor": "magenta", "showPeCoreCount": true },
    { "type": "gpu",      "key": " ",  "keyColor": "magenta" },
    { "type": "memory",   "key": " ",  "keyColor": "cyan" },
    { "type": "uptime",   "key": " ",  "keyColor": "cyan" },
    { "type": "shell",    "key": " ",  "keyColor": "green" },
    { "type": "terminal", "key": " ",  "keyColor": "green" },
    { "type": "custom", "format": "\u001b[90m─────────────────────────" },
    { "type": "colors", "symbol": "circle" }
  ]
}
