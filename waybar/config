{
  "layer": "top",
  "height": 24,
  "modules-center": [
    "sway/window"
  ],
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "backlight",
    "network",
    "cpu",
    "memory",
    "temperature",
    "sway/language",
    "idle_inhibitor",
    "custom/audio_idle_inhibitor",
    "clock",
    "battery"
  ],
  "sway/mode": {
    "format": "{}",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{volume}% {icon}{format_source}",
    "format-muted": " {format_source}",
    "format-bluetooth": "{volume}% {icon}{format_source}",
    "format-bluetooth-muted": " {icon}{format_source}",
    "format-source": "",
    "format-source-muted": "",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ],
      "car": " ",
      "headphone": " ",
      "headset": "󰋎 ",
      "hands-free": "󰋎 ",
      "phone": "",
      "portable": ""
    },
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "brightnessctl set +10%",
    "on-scroll-down": "brightnessctl set 10%-",
  },
  "network": {
    "interval": 2,
    "format-disconnected": "Disconnected ⚠",
    "format-wifi": "{essid} ({signalStrength}%) {icon}",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr} {icon}",
    "format-linked": "{ifname} (No IP) {icon}",
    "format-alt": "↓{bandwidthDownBits} ↑{bandwidthUpBits} {icon}",
    "tooltip-format-disabled": "Wi-Fi is disabled",
    "tooltip-format-wifi": "{essid}\nSignal strength: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}",
    "format-icons": {
      "disabled": "󰤮",
      "disconnected": "⚠",
      "ethernet": "󰈀",
      "linked": "",
      "wifi": [
        "󰤯 ",
        "󰤟 ",
        "󰤢 ",
        "󰤥 ",
        "󰤨 "
      ]
    },
  },
  "cpu": {
    "interval": 2,
    "format": "{usage}% ",
  },
  "memory": {
    "format": "{}% "
  },
  "sway/language": {
    "format": "{}  ",
    "tooltip-format": "{long}",
    "on-click": "swaymsg input 'type:keyboard' xkb_switch_layout next",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰿆",
      "deactivated": "󰌾"
    }
  },
  "custom/audio_idle_inhibitor": {
		"format": "{icon}",
		"exec": "sway-audio-idle-inhibit --dry-print-both-waybar",
		"exec-if": "which sway-audio-idle-inhibit",
		"return-type": "json",
		"format-icons": {
			"output": "󱨖",
			"input": "",
			"output-input": "󱨖 ",
			"none": ""
		}
	},
  "clock": {
    "format": "{:%H:%M}  ",
    "format-alt": "{:%a, %b %d %H:%M}  ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "actions": {
      "on-click-backward": "tz_down",
      "on-click-forward": "tz_up",
      "on-click-right": "mode",
      "on-scroll-down": "shift_down",
      "on-scroll-up": "shift_up"
    },
    "calendar": {
      "format": {
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>"
      },
      "mode": "year",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "on-scroll": 1,
      "weeks-pos": "right"
    },
  },
  "battery": {
    "interval": 5,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{icon} {H}:{M}",
    "format-charging": "{capacity}% ",
    "format-full": "{icon}",
    "format-unknown": "{capacity}% ",
    "format-time": "{H}:{m}",
    "format-icons": [
      "󰂎",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
  },
}
