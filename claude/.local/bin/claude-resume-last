#!/bin/zsh
# Reopen the most recently closed Claude Code chat (written by claude-session-end),
# in its own folder and profile.
f=$HOME/.local/state/claude/closed-sessions.tsv
[[ -s $f ]] || { print "No closed Claude chats recorded yet."; read -k1; exit 1; }
IFS=$'\t' read -r _ profile sid cwd < <(tail -n 1 $f)
cd $cwd 2>/dev/null || cd $HOME
if [[ $profile == personal ]]; then export CLAUDE_CONFIG_DIR=$HOME/.claude-personal
else unset CLAUDE_CONFIG_DIR; fi
exec claude --resume $sid
