#!/bin/zsh
# Open a file or folder from Finder in a new tmux window: images are shown with
# chafa, executables and .sh/.command scripts are run (the window stays until a
# key is pressed), everything else opens in nvim.
# Called by "Open in Neovim.app" (macos/open-in-neovim.applescript) and by
# kitty's launch-actions.conf with the file path.
# Uses the tmux session you were last in, then brings Ghostty to the front; with
# no attached tmux client it opens a Ghostty window attached to that session.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/bin:/bin:$PATH"
target=${1:?usage: term-open <file|dir>}

if [[ -d $target ]]; then
  dir=$target; cmd=(nvim .); name=${target:t}
elif [[ ${target:e:l} == (png|jpg|jpeg|gif|webp|bmp|tiff|tif) ]]; then
  dir=${target:h}; name=${target:t}
  # kitty graphics through tmux passthrough (works in Ghostty and kitty), sized
  # to the pane in cells, then wait for any key.
  cmd=(zsh -c 'chafa --format kitty --passthrough tmux --size "${COLUMNS}x$((LINES - 1))" -- "$1"; read -rsk1' _ "$target")
elif [[ -x $target || ${target:e:l} == (sh|command|tool) ]]; then
  dir=${target:h}; name=${target:t}
  cmd=(zsh -lc 'if [[ -x $1 ]]; then "$1"; else zsh "$1"; fi
    print -P "\n%F{8}[exited with $?] press any key to close%f"; read -rsk1' _ "$target")
else
  dir=${target:h}; cmd=(nvim -- "$target"); name=${target:t}
fi
# nvim starts in the git root when the file is in a repo, so LSP and pickers see the project.
[[ $cmd[1] == nvim ]] && root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && dir=$root

# Most recently active attached session, else the most recently used one
# (the same rule tmux-attach-last uses, so a fresh Ghostty window lands there too).
session=$(tmux list-clients -F '#{client_activity} #{client_session}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
attached=${session:+yes}
[[ -z $session ]] && session=$(tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
if [[ -z $session ]]; then
  session=main
  tmux new-session -d -s "$session" -c "$HOME"
fi

tmux new-window -t "=$session:" -n "$name" -c "$dir" "${cmd[@]}"

if [[ -n $attached ]] || ! pgrep -xq ghostty; then
  # Ghostty already shows the session, or it starts now and its default command
  # (tmux-attach-last) attaches to it.
  open -a Ghostty
else
  # Ghostty is running but no window is attached: open one on that session.
  osascript - "$session" <<'APPLESCRIPT' >/dev/null
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to "/bin/zsh --login -c \"exec tmux attach-session -t '=" & item 1 of argv & "'\""
    new window with configuration cfg
    activate
  end tell
end run
APPLESCRIPT
fi
