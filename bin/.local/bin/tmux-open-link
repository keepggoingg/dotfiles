#!/bin/zsh
# Called by tmux on clicks (tmux.conf "Click a link to open it").
#   tmux-open-link open|copy xHYPERLINK xLINE COLUMN xCWD
# The x prefix keeps empty values from vanishing as arguments; it is stripped here.
# HYPERLINK = OSC 8 link under the mouse (may be empty), LINE = clicked line,
# COLUMN = clicked column, CWD = the pane's working directory (for relative paths).
# Finds, in this order: the hyperlink, a URL under the click, or an existing file/folder
# path under the click (absolute, ~/..., or relative; a :line:col suffix is dropped).
#   open: waits out tmux's double-click time (300 ms) and opens it unless a double-click
#         came in meanwhile: text files in nvim in a new tmux window (at :line), folders
#         in Finder, anything else (URLs, images, PDFs) with macOS open.
#   copy: (double-click) cancels the pending open and copies it to the clipboard.
# Exit 1 when there is nothing under the click.
setopt extendedglob
zmodload zsh/datetime
mode=$1 link=${2#x} line=${3#x} col=$4 cwd=${${5#x}:-$PWD}
marker=${TMPDIR:-/tmp}/tmux-open-link.dblclick

# Token under the click: the first match of regex $1 that covers column $col.
token_at() {
  local rest=$line off=0 start end
  while [[ $rest =~ $1 ]]; do
    start=$(( off + MBEGIN - 1 )) end=$(( off + MEND - 1 ))
    if (( col >= start && col <= end )); then REPLY=$MATCH; return 0; fi
    off=$(( off + MEND )); rest=${rest[MEND+1,-1]}
  done
  return 1
}

if [[ $mode == open ]]; then
  clicked=$EPOCHREALTIME
  sleep 0.35
  # Skip when a double-click happened around this click: it cancels the first click's
  # open, and the second click's release (which comes after it) must not open either.
  [[ -f $marker ]] && (( $(<$marker) > clicked - 0.6 )) && exit 0
else
  print -r -- $EPOCHREALTIME > $marker
fi

if [[ -z $link ]] && token_at '(https?|file)://[^][:space:]<>\"'"'"'`()]+'; then
  link=${REPLY%%[.,;:!?]}
fi

if [[ -z $link ]] && token_at '[^][:space:]\"'"'"'`(){}<>|,;]+'; then
  p=$REPLY
  p=${p%%[.!?]#}                            # trailing sentence punctuation
  lineno=${${(M)p%%(:[0-9]##)##}#:}; lineno=${lineno%%:*}   # file.ts:12:5 -> 12
  p=${p%%(:[0-9]##)##}                      # file.ts:12:5 -> file.ts
  p=${p%:}
  shown=$p
  [[ $p == '~'* ]] && p=$HOME${p#\~}
  # Plain words only count when they look like a path (a slash or an extension).
  if [[ $p == */* || $p == *.[[:alnum:]]* ]]; then
    full=$p
    [[ $full == /* ]] || full=$cwd/$full
    if [[ -e $full ]]; then
      # Copy the path as written (relative stays relative), open the full path.
      [[ $mode == copy ]] && link=$shown || link=$full
    fi
  fi
fi

[[ -n $link ]] || exit 1
# file:// links (Claude Code marks paths this way) become plain paths, so text files
# reach nvim instead of macOS open.
if [[ $link == file://* ]]; then
  link=${link#file://}; link=${link#localhost}
  link=$(printf %b "${link//\%/\\x}")   # %20 -> space
fi
if [[ $mode == copy ]]; then
  print -rn -- $link | pbcopy
elif [[ -f $link && $(file -b --mime-encoding -- $link) != binary ]]; then
  # Text files: nvim in a new tmux window, at the clicked line if there was one.
  tmux new-window -c "${link:h}" -n "${link:t}" nvim ${lineno:+"+$lineno"} -- "$link"
else
  open "$link"
fi
