#!/usr/bin/env zsh
# Write ~/.ssh/config.d/pass-hosts with one Host per pass entry under */ssh/*,
# so `ssh web1`, `scp x web1:`, `rsync`, git and nvim's scp:// work by name.
# The alias is the last path part; when two entries share it, the parent is
# prefixed (acme-staging, blog-staging). Run again after changing pass.
emulate -L zsh
setopt err_return pipe_fail
store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
out=$HOME/.ssh/config.d/pass-hosts
mkdir -p ${out:h}; chmod 700 ${out:h}

entries=(${(f)"$(cd $store && fd --extension gpg . | sed 's/\.gpg$//' | grep '/ssh/' | sort)"})
typeset -A count
for e in $entries; do (( count[${e:t}]++ )) || true; done

tmp=$(mktemp)
print "# Generated by ssh-hosts-from-pass on $(date '+%Y-%m-%d %H:%M'). Do not edit." > $tmp
for e in $entries; do
  alias=${e:t}
  (( count[$alias] > 1 )) && alias="${${e:h}:t}-$alias"
  line=$(pass show "$e" 2>/dev/null | head -1) || { print -u2 "skip $e: cannot decrypt"; continue }
  args=("${(@Q)${(z)line}}")
  host= user= port= ident= jump= opts=()
  while (( $#args )); do
    case $args[1] in
      -p) port=$args[2]; shift 2 args ;;
      -i) ident=$args[2]; shift 2 args ;;
      -J) jump=$args[2]; shift 2 args ;;
      -l) user=$args[2]; shift 2 args ;;
      -o) opts+=("${args[2]/=/ }"); shift 2 args ;;
      -*) print -u2 "skip $e: unsupported option $args[1]"; host=; break ;;
      *)  host=$args[1]; shift args ;;
    esac
  done
  [[ -z $host ]] && { print -u2 "skip $e: no host"; continue }
  if [[ $host == *@* ]]; then user=${host%@*}; host=${host##*@}; fi
  {
    print "\n# pass: $e"
    print "Host $alias"
    print "  HostName $host"
    [[ -n $user  ]] && print "  User $user"
    [[ -n $port  ]] && print "  Port $port"
    [[ -n $ident ]] && print "  IdentityFile $ident"
    [[ -n $jump  ]] && print "  ProxyJump $jump"
    for o in $opts; do print "  $o"; done
  } >> $tmp
  print "  $alias  <-  $e"
done
mv $tmp $out; chmod 600 $out
print "wrote $out"
