# Default config for sway
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term alacritty
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
set $menu ~/.config/rofi/scripts/launcher_t2

### Exec
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec dunst
exec avizo-service
exec nm-applet
exec swaykbdd
# Enables inhibit_idle when playing audio
exec sway-audio-idle-inhibit
exec batsignal -w 30 -c 10 -d 5 -f 100 -I xfce-battery-full

### Idle configuration
exec swayidle \
    timeout 300 'swaylock' \
    timeout 360 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock'
    # before-sleep 'swaymsg "output * enable" && swaylock'

set $gnome-schema org.gnome.desktop.interface

exec gsettings set $gnome-schema gtk-theme 'Dracula'
exec gsettings set $gnome-schema icon-theme 'Papirus-Dark'
# exec gsettings set $gnome-schema cursor-theme 'Your cursor Theme'
exec gsettings set $gnome-schema font-name 'RobotoMono Nerd Font'
exec gsettings set $gnome-schema color-scheme prefer-dark

exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK

### Bindswitch
# bindswitch lid:on exec swaymsg "output eDP-1 disable"
# bindswitch lid:off exec swaymsg "output eDP-1 enable"

### Window rules
for_window [app_id="^.*"] border pixel 2
for_window [app_id="^.*"] border radius 30

set $opacity 1

# swaymsg -t get_tree
for_window [class=".*"] opacity $opacity
for_window [app_id=".*"] opacity $opacity

for_window [app_id="pavucontrol"] floating enable
for_window [app_id="pavucontrol"] floating enable

for_window [title="^Emulator$"] move scratchpad
for_window [title="Android Emulator - *"] {
  floating enable
#  border normal
}

# Turn off idle in fullscreen
# for_window [class="Chromium-browser"] inhibit_idle fullscreen
# for_window [class="^.*"] inhibit_idle fullscreen
# for_window [app_id="^.*"] inhibit_idle fullscreen

### Appearance
font pango:JetBrainsMono Nerd Font SemiBold 9.000000

default_border pixel 2
default_floating_border normal 10
hide_edge_borders none
focus_wrapping no
focus_follows_mouse yes
focus_on_window_activation smart
mouse_warping output
workspace_layout default
workspace_auto_back_and_forth yes

gaps inner 10

client.focused #6c71c4 #002b36 #93a1a1 #268bd2 #6c71c4
client.focused_inactive #073642 #586e75 #839496 #2aa198 #586e75
client.unfocused #073642 #657b83 #839496 #859900 #073642
client.urgent #dc322f #cb4b16 #fdf6e3 #d33682 #dc322f
client.placeholder #002b36 #002b36 #93a1a1 #b58900 #b58900
client.background #002b36

set $wallpaper_path $HOME/.config/sway/bg1.jpg
# output * max_render_time 5 bg $wallpaper_path fill
output * bg $wallpaper_path fill

