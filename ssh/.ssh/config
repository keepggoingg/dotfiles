# Hosts live in ~/.ssh/config.d/ (not in this repo): run `ssh-hosts-from-pass`
# to generate them from the pass entries under */ssh/*.
IgnoreUnknown UseKeychain
Include ~/.ssh/config.d/*

# GitHub picks the account by key: id_rsa is the personal account.
Host github.com
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes

Host *
  # Keys: ssh's defaults (id_rsa) plus whatever the agent holds, as before.
  # Per-host keys go in the pass entry (-i) or ~/.ssh/config.d.
  AddKeysToAgent yes
  UseKeychain yes

  # Reuse one connection per host: second tab, scp, rsync and git connect instantly.
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 10m

  # Keep idle sessions alive through NAT and VPN.
  ServerAliveInterval 30
  ServerAliveCountMax 4

  # Ask once for new hosts, refuse changed keys.
  StrictHostKeyChecking ask
  HashKnownHosts no

# minotebook by Tailscale IP, so SSH works even when a VPN takes over DNS (MagicDNS)
Host minotebook
  HostName 100.122.82.107
  HostKeyAlias minotebook
  User aleksandr

# ThinkPad laptop (Ubuntu, hostname dbqplap) on the home LAN
Host thinkpad
  HostName 192.168.1.83
  HostKeyAlias thinkpad
  User aleksandr
